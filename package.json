{
  "name": "figma-local-agent-mcp-workspace",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "build:release": "pnpm check && pnpm --filter @figma-agent/figma-plugin build -- --release && node scripts/release-artifacts.mjs && pnpm check:agent-plugin-archive",
    "check:agent-plugin": "node scripts/check-agent-plugin.mjs",
    "check:agent-plugin-archive": "node scripts/check-agent-plugin-archive.mjs",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:scripts": "node --test scripts/check-agent-plugin-archive.test.mjs",
    "test": "pnpm test:scripts && vitest run",
    "check": "pnpm check:agent-plugin && pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^24.5.2",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.4.0",
    "jszip": "^3.10.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.1",
    "vitest": "^3.2.4"
  }
}
